{
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    ".agents",
    "**/dist",
    "**/pkg",
    "**/node_modules",
    "**/*.d.ts",
    "**/*.svelte",
    "bench/results",
    "docs/src/generated",
    "packages/core/src/generated",
    "docs/src/routeTree.gen.ts",
    "**/*.md",
    "**/*.mdx",
    "**/*.html",
    "**/*.yml",
    "**/*.yaml",
    "**/*.toml",
    "**/*.vue",
    "bun.lock",
    "scripts/public-api-baseline.json",
    "bench/src/matched-formula-harness.ts"
  ],
  "sortImports": {
    "newlinesBetween": true
  },
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["test/consumer/**", "test/consumer-nodenext/**"],
      "options": {
        "sortImports": false
      }
    }
  ]
}
