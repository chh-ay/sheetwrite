{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": ["bench", "docs", "examples/*", "packages/wasm", "packages/formulas"],
  "workspaces": {
    "packages/core": {
      "entry": [
        "src/index.ts",
        "src/adapter.ts",
        "src/external-links.ts",
        "src/functions.ts",
        "src/history-archive.ts",
        "src/history-indexeddb.ts",
        "src/indexeddb.ts",
        "src/shell.ts",
        "src/testing.ts",
        "src/worker.ts",
        "test/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/queries": {
      "entry": ["src/index.ts", "src/node.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/react": {
      "entry": ["src/index.tsx", "test/**/*.test.ts?(x)"],
      "project": ["src/**/*.ts?(x)", "test/**/*.ts?(x)"]
    },
    "packages/svelte": {
      "entry": ["src/*.svelte", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/vue": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/xlsx": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/charts": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
