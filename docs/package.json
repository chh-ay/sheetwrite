{
  "name": "@sheetwrite/docs",
  "version": "0.0.2",
  "private": true,
  "description": "The docs site: TanStack Start with Solid, static pages with islands.",
  "type": "module",
  "scripts": {
    "generate": "bun ../scripts/docs-cli.ts generate",
    "build": "bun run generate && node node_modules/vite/bin/vite.js build && node node_modules/vite/bin/vite.js build --config vite.islands.config.ts && bun src/islands/page-scripts.ts && bun src/figures/og-images.ts dist/client && bun ../scripts/normalize-sitemap.ts dist/client && bunx pagefind --site dist/client",
    "build:test": "SHEETWRITE_DOCS_FIXTURES=1 bun run build",
    "figures": "bun src/figures/capture.ts",
    "typecheck": "bun run generate && node ../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@sheetwrite/charts": "workspace:*",
    "@sheetwrite/core": "workspace:*",
    "@sheetwrite/formulas": "workspace:*",
    "@sheetwrite/queries": "workspace:*",
    "@sheetwrite/react": "workspace:*",
    "@sheetwrite/svelte": "workspace:*",
    "@sheetwrite/vue": "workspace:*",
    "@sheetwrite/wasm": "workspace:*",
    "@sheetwrite/xlsx": "workspace:*",
    "@tanstack/solid-router": "1.170.41",
    "@tanstack/solid-start": "1.169.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "solid-js": "1.9.18",
    "sucrase": "^3.35.1",
    "svelte": "5.57.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@expressive-code/core": "0.44.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.3",
    "expressive-code": "0.44.0",
    "lightningcss": "1.33.0",
    "pagefind": "1.5.2",
    "prettier": "3.9.5",
    "rehype-expressive-code": "0.44.0",
    "rehype-raw": "7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "5.2.0",
    "svelte2tsx": "0.7.58",
    "tinyglobby": "0.2.17",
    "typescript": "5.9.3",
    "vite": "8.1.6",
    "vite-plugin-solid": "2.11.15"
  }
}
