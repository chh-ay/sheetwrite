{
  "name": "sheetwrite-packed-consumer",
  "private": true,
  "type": "module",
  "scripts": {
    "bundle": "bun build ./src/browser.ts --outdir dist",
    "runtime": "bun run ./src/runtime.mjs",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "bundle:frameworks": "vite build",
    "runtime:formulas": "bun run ./src/runtime-formulas.mjs",
    "runtime:queries": "node ./src/runtime-queries.mjs && bun run ./src/runtime-queries.mjs"
  },
  "dependencies": {
    "@sheetwrite/charts": "file:artifacts/sheetwrite-charts.tgz",
    "@sheetwrite/core": "file:artifacts/sheetwrite-core.tgz",
    "@sheetwrite/formula-assist": "file:artifacts/sheetwrite-formula-assist.tgz",
    "@sheetwrite/formulas": "file:artifacts/sheetwrite-formulas.tgz",
    "@sheetwrite/queries": "file:artifacts/sheetwrite-queries.tgz",
    "@sheetwrite/react": "file:artifacts/sheetwrite-react.tgz",
    "@sheetwrite/svelte": "file:artifacts/sheetwrite-svelte.tgz",
    "@sheetwrite/vue": "file:artifacts/sheetwrite-vue.tgz",
    "@sheetwrite/wasm": "file:artifacts/sheetwrite-wasm.tgz",
    "@sheetwrite/xlsx": "file:artifacts/sheetwrite-xlsx.tgz",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "svelte": "5.56.4",
    "vue": "3.5.39"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.3",
    "svelte-check": "4.7.2",
    "typescript": "6.0.3",
    "vite": "7.2.2"
  }
}
