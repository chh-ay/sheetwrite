{
  "name": "@sheetwrite/svelte",
  "version": "0.7.0",
  "type": "module",
  "description": "Svelte adapter for Sheetwrite.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chh-ay/sheetwrite.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://www.sheetwrite.dev/",
  "bugs": {
    "url": "https://github.com/chh-ay/sheetwrite/issues"
  },
  "keywords": [
    "spreadsheet",
    "data-grid",
    "svelte",
    "canvas"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./styles.css",
    "./styles/grid.css": "./styles/grid.css",
    "./styles/formula-help.css": "./styles/formula-help.css",
    "./styles/find.css": "./styles/find.css",
    "./styles/ribbon.css": "./styles/ribbon.css",
    "./styles/panels.css": "./styles/panels.css",
    "./styles/context-menu.css": "./styles/context-menu.css",
    "./styles/tabs.css": "./styles/tabs.css",
    "./styles/charts.css": "./styles/charts.css",
    "./styles/icons.css": "./styles/icons.css",
    "./styles/dashboard.css": "./styles/dashboard.css"
  },
  "files": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "styles.css",
    "styles/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run typecheck",
    "prepublishOnly": "bun run build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "peerDependencies": {
    "svelte": ">=5"
  },
  "dependencies": {
    "@sheetwrite/core": "workspace:*"
  },
  "devDependencies": {
    "svelte-check": "4.7.3",
    "typescript": "^6"
  }
}
