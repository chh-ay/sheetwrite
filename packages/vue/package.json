{
  "name": "@sheetwrite/vue",
  "version": "0.6.1",
  "type": "module",
  "description": "Vue adapter for Sheetwrite.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chh-ay/sheetwrite.git",
    "directory": "packages/vue"
  },
  "homepage": "https://www.sheetwrite.dev/",
  "bugs": {
    "url": "https://github.com/chh-ay/sheetwrite/issues"
  },
  "keywords": [
    "spreadsheet",
    "data-grid",
    "vue",
    "canvas"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./styles/grid.css": "./styles/grid.css",
    "./styles/formula-help.css": "./styles/formula-help.css",
    "./styles/find.css": "./styles/find.css",
    "./styles/ribbon.css": "./styles/ribbon.css",
    "./styles/panels.css": "./styles/panels.css",
    "./styles/context-menu.css": "./styles/context-menu.css",
    "./styles/tabs.css": "./styles/tabs.css",
    "./styles/charts.css": "./styles/charts.css",
    "./styles/icons.css": "./styles/icons.css",
    "./styles/dashboard.css": "./styles/dashboard.css"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "styles.css",
    "styles/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.declarations.json && bun ../../scripts/package-dist.ts .",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "vue": ">=3.4"
  },
  "dependencies": {
    "@sheetwrite/core": "workspace:*"
  }
}
