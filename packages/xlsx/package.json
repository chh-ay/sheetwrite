{
  "name": "@sheetwrite/xlsx",
  "version": "0.6.1",
  "type": "module",
  "description": "Optional XLSX table and workbook backends for Sheetwrite.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chh-ay/sheetwrite.git",
    "directory": "packages/xlsx"
  },
  "homepage": "https://www.sheetwrite.dev/",
  "bugs": {
    "url": "https://github.com/chh-ay/sheetwrite/issues"
  },
  "keywords": [
    "spreadsheet",
    "xlsx",
    "excel",
    "typescript"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun ../../scripts/package-dist.ts .",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sheetwrite/core": "workspace:*",
    "fflate": "0.8.3"
  }
}
