{
  "name": "@sheetwrite/formula-assist",
  "version": "0.6.1",
  "type": "module",
  "description": "Optional formula bar add-on for Sheetwrite that suggests the rest of a formula, accepted with Tab.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chh-ay/sheetwrite.git",
    "directory": "packages/formula-assist"
  },
  "homepage": "https://www.sheetwrite.dev/",
  "bugs": {
    "url": "https://github.com/chh-ay/sheetwrite/issues"
  },
  "keywords": [
    "spreadsheet",
    "formula",
    "autocomplete",
    "typescript"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun ../../scripts/package-dist.ts .",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "replay": "bun bench/replay-cli.ts"
  },
  "peerDependencies": {
    "@sheetwrite/core": "workspace:*"
  },
  "devDependencies": {
    "@sheetwrite/core": "workspace:*",
    "@sheetwrite/xlsx": "workspace:*"
  }
}
